<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <IsRoslynComponent>true</IsRoslynComponent>

        <PackageId>GreenNide.ExpressionFilter</PackageId>
        <Version>0.0.1</Version>
        <Authors>GreenNide</Authors>
        <Description>Source generator for filtering and querying collections using expression trees.</Description>
        <PackageTags>source-generator;roslyn;filter;expression-tree;linq</PackageTags>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <DevelopmentDependency>true</DevelopmentDependency>
        <NoPackageAnalysis>true</NoPackageAnalysis>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GreenNide.FilterGenerator.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\GreenNide.FilterGenerator.Abstractions\GreenNide.FilterGenerator.Abstractions.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="..\README.md" Pack="true" PackagePath="/" Visible="false" />
    </ItemGroup>

    <!-- Pack the Abstractions assembly into the lib folder -->
    <ItemGroup>
        <None Include="..\GreenNide.FilterGenerator.Abstractions\bin\$(Configuration)\netstandard2.0\GreenNide.FilterGenerator.Abstractions.dll" Pack="true" PackagePath="lib/netstandard2.0" Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis" Version="5.6.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" PrivateAssets="all" />
    </ItemGroup>

</Project>
